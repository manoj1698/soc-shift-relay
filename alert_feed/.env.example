# Copy to alert_feed/.env (git-ignored) and fill in. Never commit real keys.
SWITCH_URL=http://127.0.0.1:8000
# Registration-type key from the Gateway's API Keys page (Switch Console > Home > Full admin interface > Open)
SWITCH_REGISTRATION_KEY=
# Filled by: python alert_feed/alert_feed.py register --save
SWITCH_AGENT_ID=
SWITCH_AGENT_KEY=
# The #soc-shift room id, from: python alert_feed/alert_feed.py call list_rooms "{}"
SWITCH_ROOM_ID=
